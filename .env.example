# Copy to .env and fill in the model key. Never commit .env.

# Model provider for the four Mozaik agents: groq, openai, anthropic or google.
# Groq is reached through Mozaik's own OpenAI-compatible Chat Completions endpoint.
MODEL_PROVIDER=groq
MODEL_ID=openai/gpt-oss-120b
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Concurrent model calls. Agent loops always run concurrently; this limits how many
# requests are in flight. On Groq's free tier (8000 tokens per minute) use 1.
MODEL_CONCURRENCY_GLOBAL=1
MODEL_CONCURRENCY_WORKSPACE=1
MODEL_CALL_TIMEOUT_MS=600000
# Largest request the provider accepts, in tokens. Older tool results in a loop are
# omitted, oldest first, to stay under it. 0 disables. Groq's free tier needs about 6000.
MODEL_REQUEST_TOKEN_LIMIT=6000

# Mozaik Cloud telemetry (optional). Either set a project key here or run
# `npx @mozaik-ai/cloud-sdk pair` once; without it agents still run, just without cloud traces.
# MOZAIK_API_KEY=

# SEC asks automated clients to declare who they are: "Company contact@domain".
# Required in production. Only used for live EDGAR requests.
SEC_USER_AGENT=Errata local development you@example.com

# Local defaults work with `docker compose up -d db`.
DATABASE_URL=postgres://errata:errata@localhost:54329/errata
APP_BASE_URL=http://localhost:3000

# Production only: long random values.
# SESSION_SECRET=
# INTERNAL_API_TOKEN=

# Live EDGAR polling for live-mode workspaces (replays never poll).
ENABLE_LIVE_MONITOR=false
