{
  "name": "errata",
  "version": "0.1.0",
  "description": "Correction desk for financial research: four concurrent Mozaik agents warn readers and draft verified corrections when SEC filings are restated.",
  "license": "MIT",
  "homepage": "https://errata-smoky.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/errata.git"
  },
  "bugs": {
    "url": "https://github.com/winsznx/errata/issues"
  },
  "keywords": [
    "financial-research",
    "sec-edgar",
    "restatement",
    "non-reliance",
    "multi-agent",
    "mozaik",
    "ai-agents",
    "fintech",
    "xbrl"
  ],
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "errata": "pnpm --filter @errata/runtime cli",
    "test:e2e": "playwright test",
    "test:integration": "pnpm --filter @errata/runtime test:integration",
    "lint": "biome lint",
    "test:live": "pnpm --filter @errata/runtime cli replay --scenario nocera-q1-repair --approve"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@playwright/test": "1.65.1"
  }
}
