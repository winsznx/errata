{
  "name": "errata",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "errata": "pnpm --filter @errata/runtime cli",
    "test:e2e": "playwright test",
    "test:integration": "pnpm --filter @errata/runtime test:integration",
    "test:live": "pnpm --filter @errata/runtime cli replay --scenario nocera-q1-repair --approve"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1"
  }
}
