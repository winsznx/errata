{
  "name": "@errata/runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli/index.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@mozaik-ai/core": "4.2.0",
    "cheerio": "1.2.0",
    "decimal.js": "10.6.0",
    "docx": "9.16.0",
    "domhandler": "6.0.1",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "jszip": "3.10.2",
    "pdfkit": "0.21.0",
    "postgres": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/pdfkit": "0.17.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
